# ─── Copy to deploy/.env on the server and fill in. Never commit the filled file. ───

# Public hostname of the API (DNS A record → this server's public IP)
API_DOMAIN=api.yourdomain.in

# Database password: letters and digits only (it goes inside a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Frontend address(es) allowed to call the API with cookies, comma-separated, no trailing slash
CORS_ORIGINS=https://yourdomain.in,https://www.yourdomain.in

# JWT secrets: two different long random values. Generate each: openssl rand -hex 48
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Providers
LLM_PROVIDER=groq
EMBEDDING_PROVIDER=gemini
STORAGE_PROVIDER=r2

# LLM / embeddings (same keys as on your laptop)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Kafka client name
KAFKA_CLIENT_ID=smart-city-backend

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=smart-city-photos

# Gmail SMTP (16-character app password)
SMTP_USER=
SMTP_APP_PASSWORD=

# Google sign-in (same client ID as the frontend)
GOOGLE_CLIENT_ID=
